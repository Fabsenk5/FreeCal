DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="your-super-secret-jwt-key"
PORT=3000
NODE_ENV="development"

# Production frontend origin - used for CORS whitelist and password reset links.
# Fallback when unset: CORS stays open (with a startup warning) and reset links
# point to http://localhost:5173 (dev only).
FRONTEND_URL="https://freecal.vercel.app"

# Supabase service role key - required for event details (comments/checklists)
# and push notifications, which bypass RLS via supabaseAdmin.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Web Push (VAPID)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
